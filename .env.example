# ==============================================================================
# AUTH SERVICE ENVIRONMENT CONFIGURATION (POSTGRESQL + SEQUELIZE)
# ==============================================================================

PORT=5001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# PostgreSQL Connection String (Local or Cloud like Neon / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db

# JWT Access Token Configuration (Short-Lived: 15 minutes)
JWT_SECRET=supersecret_jwt_chat_key_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=15m

# JWT Refresh Token Configuration (Long-Lived: 7 days)
JWT_REFRESH_SECRET=supersecret_refresh_jwt_key_2026_change_in_production
